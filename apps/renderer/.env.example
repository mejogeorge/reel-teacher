# Convex deployment URL (same as web's NEXT_PUBLIC_CONVEX_URL)
CONVEX_URL=

# Must match WORKER_SECRET set in the Convex dashboard
WORKER_SECRET=

# Identifies this worker instance in leases/heartbeats
WORKER_ID=local-worker-1

# Max simultaneous renders (default 1 — one video/day)
RENDER_CONCURRENCY=1

# Where the Kokoro ONNX model + Chromium build are cached
MODEL_CACHE_DIR=./.model-cache
