# =============================================================================
# Convex-side environment variables.
# Set these in the Convex dashboard (Settings -> Environment Variables),
# NOT in a local .env file. Listed here for reference.
# =============================================================================

# Anthropic (content generation, word pick, safety)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Dictionary fallback (optional)
WORDNIK_API_KEY=

# Shared secret the renderer worker must present (long random string)
WORKER_SECRET=

# Comma-separated admin emails allowed into the dashboard
ADMIN_EMAILS=

# Clerk <-> Convex auth
CLERK_JWT_ISSUER_DOMAIN=
