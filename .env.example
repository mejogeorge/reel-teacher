# =============================================================================
# Convex-side environment variables.
# Set these in the Convex dashboard (Settings -> Environment Variables),
# NOT in a local .env file. Listed here for reference.
# =============================================================================

# Anthropic (content generation, word pick, safety)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Dictionary fallback (optional)
WORDNIK_API_KEY=

# Shared secret the renderer worker must present (long random string)
WORKER_SECRET=

# Comma-separated admin emails allowed into the dashboard
ADMIN_EMAILS=

# LLM provider (set at least one). Gemini used if only GEMINI_API_KEY is set.
GEMINI_API_KEY=

# Convex Auth (email + password) signing keys — generate + set these:
#   JWT_PRIVATE_KEY  (PKCS8 RSA private key)
#   JWKS             (public JWK set)
#   SITE_URL         (dashboard URL, e.g. http://localhost:3000)
# The `npx @convex-dev/auth` initializer sets these for you.
